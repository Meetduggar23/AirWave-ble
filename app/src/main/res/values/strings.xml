    <!-- v3.2.6: richer about page -->
    <string name="about_desc">AirWave lets you chat with people around you without internet, accounts, or servers. Everything travels directly between phones over Bluetooth — nothing is ever uploaded anywhere.</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_1">Turn on Bluetooth and let friends discover you</string>
    <string name="about_how_2">Tap a nearby person or scan their QR code to connect</string>
    <string name="about_how_3">Chat one-to-one or create a group — the group host relays messages so everyone stays in sync</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_body">No accounts, no phone number, no analytics. Chats live only in memory for the session and disappear when you leave.</string>
