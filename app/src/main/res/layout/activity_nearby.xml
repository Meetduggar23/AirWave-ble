<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_back" />

        <!-- v3.2.6: single logo, truly centered between the edges (it sat inside
             a weighted LinearLayout, so it was slightly left of center). -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:src="@drawable/topleftcorner" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/tap_to_connect"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/rescanButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_rescan"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/colorPrimary"
            android:text="@string/rescan"
            android:textAllCaps="false"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp" />

        <Button
            android:id="@+id/scanQrButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@null"
            android:drawableStart="@drawable/ic_scan"
            android:drawablePadding="8dp"
            android:drawableTint="@android:color/white"
            android:text="@string/scan_qr"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/createGroupButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_outline"
        android:backgroundTint="@null"
        android:drawableStart="@drawable/ic_group"
        android:drawablePadding="8dp"
        android:drawableTint="?attr/colorPrimary"
        android:text="@string/create_group"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/peersList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="10dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_radar"
                android:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/no_peers_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/no_peers_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp" />

            <Button
                android:id="@+id/emptyScanQr"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@null"
                android:drawableStart="@drawable/ic_scan"
                android:drawablePadding="8dp"
                android:drawableTint="@android:color/white"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/scan_qr_instead"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
